# ============================================
# CAJAVIVA — PLANTILLA DE SECRETOS MCP
# Copiar a .ai/mcp/.env.secrets y rellenar.
# El archivo .env.secrets esta GIT-IGNORED.
# ============================================

# Neon PostgreSQL serverless (driver asyncpg)
NEON_DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Render API Key (Account Settings > API Keys)
RENDER_API_KEY=""

# Vercel Access Token (Account Settings > Tokens)
VERCEL_TOKEN=""

# Repositorio monorepo
GITHUB_REPO_URL="https://github.com/USUARIO/REPO.git"

# Opcionales (auto-descubiertos si estan vacios)
RENDER_SERVICE_NAME="cajaviva-api"
RENDER_OWNER_ID=""
VERCEL_PROJECT_NAME="cajaviva"
BACKEND_ROOT_DIR=""
FRONTEND_ROOT_DIR=""
