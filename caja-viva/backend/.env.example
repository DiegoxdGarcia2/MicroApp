# CajaViva Sync API - Environment Variables
# Copia este archivo a .env y ajusta los valores

# ============================================
# APP CONFIGURATION
# ============================================
APP_NAME="CajaViva Sync API"
DEBUG=true
API_V1_STR=/api/v1
ENVIRONMENT=development  # development, production, staging

# ============================================
# DATABASE
# ============================================
# PostgreSQL/Neon (production) - Neon requiere sslmode=require
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# PostgreSQL local
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cajaviva
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./cajaviva.db

# Database pool settings (solo PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS
# ============================================
# Orígenes permitidos separados por comas
# En producción: https://tu-dominio.com,https://www.tu-dominio.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ============================================
# SYNC SETTINGS
# ============================================
MAX_BATCH_SIZE=100
SYNC_TIMEOUT_SECONDS=30